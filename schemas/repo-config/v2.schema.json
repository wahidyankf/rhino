    },
    "RangeSelector": {
      "enum": ["explicit"],
      "type": "string"
    },
    "ReadmeAnnotation": {
      "additionalProperties": false,
      "description": "Exact text a named README must carry. It is a declared index annotation,\nnot a judgement about the surrounding prose.",
      "properties": {
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["path", "text"],
      "type": "object"
    },
    "ReadmeIndexPolicy": {
      "additionalProperties": false,
      "description": "A declared README tree and the limited index facts its repository owns.\n\nDirect-child completeness is intentionally a boolean because the complete\nchild set is an observable tree fact, not a second manually maintained\nlist. Exclusions and annotations remain data: RHINO does not infer either.",
      "properties": {
        "trees": {
          "items": {
            "$ref": "#/$defs/ReadmeIndexTree"
          },
          "type": "array"
        }
      },
      "type": "object"
