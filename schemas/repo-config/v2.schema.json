          "$ref": "#/$defs/Harness"
        },
        {
          "type": "null"
        }
      ]
    },
    "policies": {
      "anyOf": [
        {
          "$ref": "#/$defs/Policies"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "anyOf": [
        {
          "$ref": "#/$defs/Repository"
        },
        {
          "type": "null"
        }
      ]
    },
    "scan": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scan"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "$ref": "#/$defs/SchemaId"
    },
    "toolchains": {
      "anyOf": [
        {
          "$ref": "#/$defs/Toolchains"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["schema"],
  "title": "Document",
  "type": "object"
}
