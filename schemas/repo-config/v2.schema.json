          },
          "type": "array"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "require-direct-children": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": ["path"],
      "type": "object"
    },
    "Repository": {
      "additionalProperties": false,
      "type": "object"
    },
    "Requirements": {
      "additionalProperties": false,
      "description": "One complete axis set. A profile must represent every item required on each\naxis; an empty axis means the repository has no requirement of that kind.",
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "denials": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "grants": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "identities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "routes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Scan": {
      "additionalProperties": false,
      "description": "Directory names excluded from every tree walk.\n\nThe list is declared rather than inferred from ignore files: repositories\nchoose whether generated or local paths are out of a policy's scope, and\nevery grouped validator that uses the shared scanner receives the same\nanswer.",
      "properties": {
        "exclude-directories": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SchemaId": {
      "enum": ["rhino/repo-config/v2"],
      "type": "string"
    },
    "StagedEnvironmentPolicy": {
      "additionalProperties": false,
      "description": "Exact repository patterns for the Git-index environment guard. The policy\nis optional because an absent section must not make Rhino invent secret-file\nnames; an explicit policy is checked only against staged paths.",
      "properties": {
        "allowed": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Surface": {
      "additionalProperties": false,
      "properties": {
        "fail": {
          "description": "Strictly greater than this is a finding: a file exactly at the\ndeclared count passes. RHINO holds no number of its own.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "glob": {
          "type": "string"
        },
        "target": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "warn": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": ["integer", "null"]
        }
      },
      "required": ["glob", "fail"],
      "type": "object"
    },
    "Tier": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": ["model", "effort"],
      "type": "object"
    },
    "TierFields": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": ["model", "effort"],
      "type": "object"
    },
    "Toolchain": {
      "additionalProperties": false,
