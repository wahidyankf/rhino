              "type": "null"
            }
          ]
        },
        "probe": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "provision": {
          "items": {
            "$ref": "#/$defs/ToolchainProvision"
          },
          "type": "array"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "timeout-seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "version": {
          "type": ["string", "null"]
        }
      },
      "required": ["id", "executable"],
      "type": "object"
    },
    "ToolchainOutputParser": {
      "description": "The output shapes that Rhino can compare without reporting tool output.",
      "enum": ["first-line", "first-token"],
      "type": "string"
    },
    "ToolchainProvision": {
      "additionalProperties": false,
      "description": "One platform-specific no-shell provision vector.",
      "properties": {
        "arguments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "executable": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "required": ["platform", "executable"],
      "type": "object"
    },
    "Toolchains": {
      "additionalProperties": false,
      "description": "Ordered, repository-declared toolchain probes and provision vectors. Core\nstores no installation default; a missing section refuses its command.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/Toolchain"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "TraceabilityArtifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["id", "path"],
      "type": "object"
    },
    "TraceabilityPolicy": {
      "additionalProperties": false,
      "description": "Artifact presence and exact declared links, without a prose-quality rule.",
      "properties": {
