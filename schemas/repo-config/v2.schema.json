        }
      },
      "required": ["from", "to"],
      "type": "object"
    },
    "Translation": {
      "additionalProperties": false,
      "description": "One capability projection into the declared native adapter format.",
      "properties": {
        "capability": {
          "type": ["string", "null"]
        },
        "entries": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "field": {
          "type": "string"
        },
