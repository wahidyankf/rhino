    "Tree": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": ["path"],
      "type": "object"
    },
    "VendorPolicy": {
      "additionalProperties": false,
      "description": "Exact vocabulary that may not appear in declared portable source roots.\n\nAn exception pairs one term with exact paths, preventing a broad exception\nfrom silently disabling another term or another part of a tree.",
      "properties": {
        "excluded-binding-roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "forbidden-terms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "vocabulary-exceptions": {
          "items": {
            "$ref": "#/$defs/VocabularyException"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "VocabularyException": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "term": {
          "type": "string"
        }
      },
      "required": ["term"],
      "type": "object"
    },
    "When": {
      "enum": ["always", "requires", "denies", "constrains"],
      "type": "string"
    },
    "WordBudget": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "$ref": "#/$defs/WordRule",
          "description": "What this repository means by a word.\n\nRequired, because the two repositories being reconciled here already\ndisagree: one counts runs of letters and digits, the other counts\nwhitespace-separated fields, and one repository's `AGENTS.md` is 749\nwords by its own rule and 905 by the other's. A tool that picked either\nwould be enforcing a budget the repository never set."
        },
        "surfaces": {
          "description": "Ordered: where two globs match one file, the last matching entry wins,\nwhich is how a specific surface overrides a general tree.",
          "items": {
            "$ref": "#/$defs/Surface"
          },
          "type": "array"
        }
      },
      "required": ["count", "surfaces"],
      "type": "object"
    },
    "WordRule": {
      "description": "The two definitions of a word in use, each transcribed rather than designed.",
      "oneOf": [
        {
          "const": "letters-and-digits",
          "description": "A run of letters, marks, and digits, optionally joined to another such\nrun by an apostrophe, hyphen, or underscore. Markdown syntax and\npunctuation count for nothing; a URL counts as its several parts.",
          "type": "string"
        },
        {
          "const": "whitespace-separated",
          "description": "Anything between two runs of whitespace. `**bold**` is one word, and so\nis a whole URL.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The only grouped configuration this version accepts.\n\nGroups are optional: an omitted group states no policy, while an empty one\nis an explicit but currently empty owner boundary. Both forms are preserved\nwithout guessing policy that a repository did not write.",
  "properties": {
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Environment"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "description": "Owner namespaces are validated, but their mappings are opaque to core.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "type": "object"
    },
    "gates": {
      "anyOf": [
        {
          "$ref": "#/$defs/Gates"
        },
        {
          "type": "null"
        }
      ]
    },
    "harness": {
