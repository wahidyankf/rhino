{
  "$defs": {
    "Adapter": {
      "additionalProperties": false,
      "description": "One native profile representation of canonical agents or skills.",
      "properties": {
        "absent": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fixed": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "format": {
          "$ref": "#/$defs/AdapterFormat"
        },
        "identity": {
          "additionalProperties": {
            "$ref": "#/$defs/Identity"
          },
          "type": "object"
        },
        "path": {
          "description": "The output pattern, with exactly one `{name}` placeholder.",
          "type": "string"
        },
        "route": {
          "description": "The repository-owned route template, with exactly one `{path}`\nplaceholder for the canonical source path.",
          "type": "string"
        },
        "route-field": {
          "description": "`body` for front-matter prose, or the scalar field that holds a TOML\nroute. The format decides which spelling is representable.",
          "type": "string"
        },
        "tier-fields": {
          "anyOf": [
            {
              "$ref": "#/$defs/TierFields"
            },
            {
              "type": "null"
            }
          ]
        },
        "translations": {
          "items": {
            "$ref": "#/$defs/Translation"
          },
          "type": "array"
        }
      },
      "required": ["path", "format", "route-field", "route"],
      "type": "object"
    },
    "AdapterFormat": {
      "enum": ["front-matter", "toml"],
      "type": "string"
    },
    "Argument": {
      "additionalProperties": false,
      "description": "Exactly one literal or resolved input reaches one argv position.",
      "properties": {
        "expand": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArgumentExpansion"
            },
            {
              "type": "null"
            }
          ]
        },
        "input": {
          "type": ["string", "null"]
        },
        "literal": {
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "ArgumentExpansion": {
      "enum": ["single", "repeat"],
      "type": "string"
    },
    "AuthoringRule": {
      "description": "The two diagram authoring rules, one of which a repository declares.\n\nClosed, and closed on purpose: the contract's whole argument is that a\nrepository having both is the state in which a reader cannot predict what\nthey will get and no tool can check either rule.",
      "oneOf": [
        {
          "const": "rendered",
          "description": "Mermaid, carrying both an accessible title and an accessible\ndescription.",
          "type": "string"
        },
        {
          "const": "plain-text",
          "description": "ASCII with prose beside it, and no Mermaid at all.",
          "type": "string"
        }
      ]
    },
    "Canonical": {
      "additionalProperties": false,
      "description": "The field vocabulary the repository uses in canonical front matter. Rhino\nreads those declared keys; it does not assume a particular catalog writes\ngrants as `capabilities` or `requires`.",
      "properties": {
        "agents": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalAgent"
            },
            {
              "type": "null"
            }
          ]
        },
        "skills": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDocument"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "CanonicalAgent": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "type": "string"
        },
        "denials": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "grants": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tier": {
          "type": ["string", "null"]
        }
      },
      "required": ["name", "description", "grants", "denials", "constraints"],
      "type": "object"
    },
    "CanonicalDocument": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["name", "description"],
      "type": "object"
    },
    "CiMutation": {
      "enum": ["verify-clean"],
      "type": "string"
    },
    "Composition": {
      "additionalProperties": false,
      "description": "The one relationship that can compose lifecycle surfaces. It is explicit so\nan omitted setting never quietly becomes a product default.",
      "properties": {
        "pull-request": {
          "$ref": "#/$defs/PullRequestComposition"
        }
      },
      "required": ["pull-request"],
      "type": "object"
    },
    "CompositionRelation": {
      "enum": ["exact", "at-least"],
      "type": "string"
    },
    "ConventionsPolicy": {
      "additionalProperties": false,
      "description": "Configured license placement and content checks. A path can require exact\nidentifiers, a SHA-256 digest, or both; omitted checks are never supplied\nby RHINO. Exclusions are exact repository-relative paths.",
      "properties": {
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/LicensePolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "DirectoryMap": {
      "additionalProperties": false,
      "properties": {
        "trees": {
          "items": {
            "$ref": "#/$defs/Tree"
          },
          "type": "array"
        }
      },
      "required": ["trees"],
      "type": "object"
    },
    "Environment": {
      "additionalProperties": false,
      "description": "Repository-declared source/target pairs for local environment setup.\n\nValues live only in the source file; configuration names paths, never\nsecret values. A missing group refuses environment operations, while an\nexplicitly empty group permits only the zero-file validation/backup plan.",
      "properties": {
        "allowlists": {
          "items": {
            "$ref": "#/$defs/EnvironmentAllowlist"
          },
          "type": "array"
        },
        "contracts": {
          "items": {
            "$ref": "#/$defs/EnvironmentContract"
          },
          "type": "array"
        },
        "detectors": {
          "items": {
            "$ref": "#/$defs/EnvironmentDetector"
          },
          "type": "array"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/EnvironmentExample"
          },
          "type": "array"
        },
        "staged": {
          "anyOf": [
            {
              "$ref": "#/$defs/StagedEnvironmentPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "EnvironmentAllowlist": {
      "additionalProperties": false,
      "description": "A narrowly scoped, auditable finding suppression. All dimensions are exact\nstrings so a consumer cannot suppress a whole class of detector output.",
      "properties": {
        "expiry": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": ["rule", "path", "key", "reason", "owner", "expiry"],
      "type": "object"
    },
    "EnvironmentContract": {
      "additionalProperties": false,
      "description": "One source-owned contract: a relative public declaration path and the\nenvironment-key names its consumers may read. Values are never configured.",
      "properties": {
        "keys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        }
      },
      "required": ["path"],
      "type": "object"
    },
    "EnvironmentDetector": {
      "additionalProperties": false,
      "description": "A closed language reader over explicit relative source paths. Requiring the\npaths prevents a validator from discovering and opening an undeclared file.",
      "properties": {
        "language": {
          "$ref": "#/$defs/EnvironmentLanguage"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": ["language"],
      "type": "object"
    },
    "EnvironmentExample": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": ["source", "target"],
      "type": "object"
    },
    "EnvironmentLanguage": {
      "description": "The deliberately small curated detector vocabulary.",
      "enum": ["rust", "type-script", "f-sharp", "go", "terraform", "ansible"],
      "type": "string"
    },
    "EnvironmentProjection": {
      "additionalProperties": false,
      "description": "One environment variable, mapped to one declared input field. Values never\ncome from inherited process environment or a shell template.",
      "properties": {
        "input": {
          "type": "string"
        }
      },
      "required": ["input"],
      "type": "object"
    },
    "Frontmatter": {
      "additionalProperties": false,
      "properties": {
        "surfaces": {
          "description": "Ordered, last match wins, as everywhere else surfaces are declared.",
          "items": {
            "$ref": "#/$defs/FrontmatterSurface"
          },
          "type": "array"
        }
      },
      "required": ["surfaces"],
      "type": "object"
    },
    "FrontmatterSurface": {
      "additionalProperties": false,
      "properties": {
        "enum": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "description": "Keys whose value must come from a declared set.\n\nWritten `enum:` in the document, which is the word a reader of the\nconfiguration expects and a word Rust will not spell.",
          "type": "object"
        },
        "forbid": {
          "default": [],
          "description": "Keys that may not appear.\n\nThis is what lets a repository keep a rule RHINO knows nothing about --\n\"this tree does not carry a date\" -- without RHINO having to know what\nthe rule is for.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "glob": {
          "type": "string"
        },
        "iso-date": {
          "default": [],
          "description": "Keys whose value must be an ISO calendar date.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "require": {
          "description": "Keys that must be present. Required and may be empty, because a surface\nthat requires nothing and a surface whose requirements were forgotten\nhave to look different in the file.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": ["glob", "require"],
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "description": "One uniquely named gate and its direct lifecycle memberships.",
      "properties": {
        "command": {
          "anyOf": [
            {
              "$ref": "#/$defs/GateCommand"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/GateInput"
          },
          "type": "object"
        },
        "mutation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MutationContract"
            },
            {
              "type": "null"
            }
          ]
        },
        "run-on": {
          "additionalProperties": false,
          "properties": {
            "commit-msg": {
              "$ref": "#/$defs/GateMembership"
            },
            "main": {
              "$ref": "#/$defs/GateMembership"
            },
            "manual": {
              "$ref": "#/$defs/GateMembership"
            },
            "pre-commit": {
              "$ref": "#/$defs/GateMembership"
            },
            "pre-push": {
              "$ref": "#/$defs/GateMembership"
            },
            "pull-request": {
              "$ref": "#/$defs/GateMembership"
            },
            "scheduled": {
              "$ref": "#/$defs/GateMembership"
            }
          },
          "type": "object"
        },
        "type": {
          "$ref": "#/$defs/GateKind"
        }
      },
      "required": ["id", "type", "run-on"],
      "type": "object"
    },
    "GateCommand": {
      "additionalProperties": false,
      "description": "An executable plus typed argv and explicitly named environment projections.\nThere is intentionally no string command field and no template expansion.",
      "properties": {
        "args": {
          "items": {
            "$ref": "#/$defs/Argument"
          },
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/EnvironmentProjection"
          },
          "type": "object"
        },
        "executable": {
          "type": "string"
        }
      },
      "required": ["executable"],
      "type": "object"
    },
    "GateInput": {
      "additionalProperties": false,
      "description": "The portable input vocabulary. A product may use a range to invoke another\ntool, but the configuration never names that tool as an input type.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/InputKind"
        }
      },
      "required": ["kind"],
      "type": "object"
    },
    "GateKind": {
      "description": "A gate either checks a snapshot or declares the mutation contract it will\ngain in the following delivery item. Keeping the kinds closed prevents a\ncaller from smuggling product-specific behavior into a portable lifecycle.",
      "enum": ["check", "mutation"],
      "type": "string"
    },
    "GateMembership": {
      "additionalProperties": false,
      "description": "A direct membership can explain why a pull-request includes a gate that no\nlocal quality surface owns. The reason is deliberately attached to the gate\nitself rather than a broad CI switch, so a reader can audit each extra.",
      "properties": {
        "bind": {
          "additionalProperties": {
            "$ref": "#/$defs/InputBinding"
          },
          "type": "object"
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "Gates": {
      "additionalProperties": false,
      "description": "The declared lifecycle gates. The model owns only portable scheduling data:\na repository names its gates and the semantic surface at which each belongs;\nit never delegates an untyped command string to Rhino.",
      "properties": {
        "composition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Composition"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/Gate"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "GovernancePolicy": {
      "additionalProperties": false,
      "description": "Repository-neutral governance policy. The names below carry no hierarchy or\norganisation vocabulary; every root, layer, category, term, artifact, and\nrelationship comes from the consuming repository.",
      "properties": {
        "directory-map": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectoryMap"
            },
            {
              "type": "null"
            }
          ]
        },
        "layers": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "traceability": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceabilityPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "vendor": {
          "anyOf": [
            {
              "$ref": "#/$defs/VendorPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "word-budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/WordBudget"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Harness": {
      "additionalProperties": false,
      "description": "Canonical requirements and the adapter profiles that must preserve them.\n\nThe canonical bodies themselves are deliberately not duplicated here: they\nremain the repository's root instruction and `.agents` trees. This group\nstates only the portable meaning each profile must be able to carry.",
      "properties": {
        "canonical": {
          "anyOf": [
            {
              "$ref": "#/$defs/Canonical"
            },
            {
              "type": "null"
            }
          ]
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/Profile"
          },
          "type": "array"
        },
        "requirements": {
          "$ref": "#/$defs/Requirements",
          "default": {}
        }
      },
      "type": "object"
    },
    "Identity": {
      "enum": ["name", "description"],
      "type": "string"
    },
    "InputBinding": {
      "additionalProperties": false,
      "description": "A surface supplies an input from one generic source. It cannot replace a\ngate's command: membership changes data, never behavior.",
      "properties": {
        "fallback": {
          "description": "A repository-declared comparison ref used only when a pre-push update\ncreates a new ref and therefore supplies no remote base object.",
          "type": ["string", "null"]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/RangeSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/InputSource"
        }
      },
      "required": ["source"],
      "type": "object"
    },
    "InputKind": {
      "enum": ["files", "commit-message", "commit-range", "repository-state"],
      "type": "string"
    },
    "InputSource": {
      "enum": [
        "git-index",
        "hook-message-file",
        "push-updates",
        "explicit-range",
        "checkout"
      ],
      "type": "string"
    },
    "InstructionAdapter": {
      "additionalProperties": false,
      "description": "One exact root-instruction adapter. It is managed as an individual file so\na route such as `CLAUDE.md` never grants ownership of the repository root.",
      "properties": {
        "path": {
          "type": "string"
        },
        "route": {
          "type": "string"
        }
      },
      "required": ["path", "route"],
      "type": "object"
    },
    "InternalLink": {
      "additionalProperties": false,
      "properties": {
        "exclude-sources": {
          "default": [],
          "description": "Globs excluded as link *sources*. Files under them stay valid targets.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LayerPolicy": {
      "additionalProperties": false,
      "description": "The complete directory vocabulary and its required layer sequence.",
      "properties": {
        "categories": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "type": "string"
        }
      },
      "required": ["root"],
      "type": "object"
    },
    "LicensePath": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": ["string", "null"]
        }
      },
      "required": ["path"],
      "type": "object"
    },
    "LicensePolicy": {
      "additionalProperties": false,
      "properties": {
        "exclusions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/LicensePath"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LocalMutation": {
      "enum": ["apply-index"],
      "type": "string"
    },
    "MarkdownPolicy": {
      "additionalProperties": false,
      "description": "Markdown policy is explicitly opt-in. Each named validator refuses an\nomitted sub-policy rather than turning a repository's prose into an\nundeclared product default.",
      "properties": {
        "frontmatter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Frontmatter"
            },
            {
              "type": "null"
            }
          ]
        },
        "internal-link": {
          "anyOf": [
            {
              "$ref": "#/$defs/InternalLink"
            },
            {
              "type": "null"
            }
          ]
        },
        "mermaid": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mermaid"
            },
            {
              "type": "null"
            }
          ]
        },
        "readme-index": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadmeIndexPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Mermaid": {
      "additionalProperties": false,
      "properties": {
        "authoring-rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthoringRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The one authoring rule this repository applies to conceptual diagrams.\n\nOptional, on the same rule as every section added after `v0.1`. Absent\nleaves both halves unchecked, which is what a repository that never\nadopted the rule already had -- and a default would be RHINO choosing an\nauthoring style on a repository's behalf, which is the one thing the\ncontract says a repository decides."
        },
        "edge-colors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "edge-label-graphemes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "fill-colors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "node-label-graphemes": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "text-colors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "node-label-graphemes",
        "edge-label-graphemes",
        "fill-colors",
        "edge-colors",
        "text-colors"
      ],
      "type": "object"
    },
    "MutationContract": {
      "additionalProperties": false,
      "description": "A mutation has one local index operation and one disposable PR replay.\nPairing them in the declaration prevents a formatter from becoming a local\nconvenience command that has never faced its pull-request safety proof.",
      "properties": {
        "ci": {
          "$ref": "#/$defs/CiMutation"
        },
        "local": {
          "$ref": "#/$defs/LocalMutation"
        }
      },
      "required": ["local", "ci"],
      "type": "object"
    },
    "PlansPolicy": {
      "additionalProperties": false,
      "type": "object"
    },
    "Policies": {
      "additionalProperties": false,
      "description": "Policies are grouped by portable concern. Each sub-group is closed so a\nspelling error cannot become an unenforced policy, yet absence still means\nthe named concern was not adopted.",
      "properties": {
        "conventions": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConventionsPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "governance": {
          "anyOf": [
            {
              "$ref": "#/$defs/GovernancePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "markdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarkdownPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "plans": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlansPolicy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "description": "A data-declared adapter family. `id` is an opaque repository identifier;\ncore code neither names nor branches on any particular consumer. Each\ngenerated document declares its native path and representation rather than\ninheriting a broad vendor directory as a mutable root.",
      "properties": {
        "agent-adapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/Adapter"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
