/target
/local-tmp
/node_modules
/dist
lcov.info

# Real environment files hold local secrets that exist nowhere else. Only the
# template is committable.
.env
.env.*
!.env.example

# Task worktrees live in the repository so this repository's own rules can see
# them. Only the placeholder is tracked; a worktree never enters history.
/worktrees/*
!/worktrees/.gitkeep
