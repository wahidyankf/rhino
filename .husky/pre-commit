# A hook is a sequence, and without this a gate that failed would print its
# finding and let the commit through -- the failure mode a gate cannot have.
set -e

root=$(git rev-parse --show-toplevel)
export PATH="$root/node_modules/.bin:$PATH"

# What runs here, and in what order, is declared in `repo-config.yml`. The
# surface holds staged-file formatting only (C6): the formatter rewrites the
# staged files and restages them. Every check, test, and scan runs at the
# pull-request surface, and the leak scan runs at pre-push over the range.
exec go run ./cmd/rhino gate run --surface pre-commit
