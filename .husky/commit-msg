# A hook is a sequence, and without this a gate that failed would print its
# finding and let the commit through -- the failure mode a gate cannot have.
set -e

root=$(git rev-parse --show-toplevel)
export PATH="$root/node_modules/.bin:$PATH"

# What runs here, and in what order, is declared in `repo-config.yml`. Rhino
# resolves Git's canonical message file and projects its text only to the gates
# that explicitly declare the typed commit-message input.
exec cargo run --quiet --bin rhino -- gate run --surface commit-msg --message-file "$1"
