# A hook is a sequence, and without this a gate that failed would print its
# finding and let the push through -- the failure mode a gate cannot have.
set -e

# The last local moment before anything reaches the remote, which for a public
# repository is the moment publication begins.
#
# Git supplies the ref updates on stdin, and `--push-updates-stdin` is what lets
# the dispatcher read them: without it a push-update range is refused rather
# than guessed. The range gate then screens every commit this push would
# publish -- each one's additions, names, and message -- not only the tree it
# ends at. Git's own arguments are deliberately not forwarded: arguments after
# `--` reach every gate on the surface, and nothing declared here takes a remote
# name or a URL.
#
# The quick gate is the last entry on this surface and carries its own HIPPO
# guard, because it is the one gate here that is real compute. HIPPO cannot
# guard HIPPO; RHINO has no such constraint, so it does not exempt itself. Exit
# 124 means a limit stopped the work and the reason on stderr says which:
# retry, never bypass.
exec cargo run --quiet --bin rhino -- gate run --surface pre-push --push-updates-stdin
